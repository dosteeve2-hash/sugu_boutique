# Base Postgres Neon (projet "sugu"). Chaîne poolée. Ne jamais commiter la vraie valeur.
DATABASE_URL=

# Secret Better Auth : openssl rand -hex 32
BETTER_AUTH_SECRET=

# URL publique de l'application (production)
BETTER_AUTH_URL=https://duka-kappa.vercel.app

# Optionnel : e-mails de réinitialisation du mot de passe (Resend). Sans ces deux variables, la page
# "Mot de passe oublié" renvoie vers le contact public.
RESEND_API_KEY=
MAIL_FROM=
